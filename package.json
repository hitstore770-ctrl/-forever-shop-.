body {
  direction: rtl;
  text-align: right;
  background: linear-gradient(180deg, var(--color-cream) 0%, var(--color-cream-blue) 100%);
  color: var(--color-navy);
  font-family: "Assistant", sans-serif;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5 {
  font-family: "Bona Nova S", serif;
}

.logo-text {
  font-family: "Assistant", sans-serif;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
}

::selection {
  background: var(--color-gold);
  color: var(--color-navy-deep);
}

img, .no-select-card {
  -webkit-user-select: none;
  -moz-user-select: none;
  user-select: none;
  -webkit-user-drag: none;
  user-drag: none;
  -webkit-touch-callout: none;
}

input, select, textarea {
  font-size: 16px !important;
}

button {
  -webkit-tap-highlight-color: transparent;
}

/* Ambilight golden radial glow behind hero video */
.ambilight-bg {
  background: radial-gradient(
    ellipse at 50% 40%,
    rgba(201, 162, 75, 0.35) 0%,
    rgba(15, 37, 69, 0.6) 55%,
    rgba(10, 26, 51, 1) 100%
  );
}

/* Floating gold particle */
.gold-particle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 162, 75, 0.55) 0%, rgba(201, 162, 75, 0) 70%);
  pointer-events: none;
}
